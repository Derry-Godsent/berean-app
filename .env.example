# Copy to .env.local (git-ignored). Everything here is PUBLIC once built —
# never put secrets (service keys, AI keys, webhook secrets) in VITE_ variables.

# --- Backend (Supabase) — see docs/02-ARCHITECTURE.md -----------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI answer gateway (Edge Function URL, not a provider key) -------------
VITE_ASK_ENDPOINT=

# --- Funding page — see docs/03-FUNDING.md ---------------------------------
# Leave a link empty and that option simply doesn't show.
VITE_CONTACT_EMAIL=
VITE_GIVE_KOFI_URL=
VITE_GIVE_PAYSTACK_URL=
VITE_GIVE_PAYPAL_URL=
# Total given so far, in whole US dollars: places the progress meter on the
# milestones in src/app/funding.ts. Leave empty to hide the meter.
VITE_FUNDING_RAISED_USD=

# --- Where the app lives ------------------------------------------------
# Used in links people share. Empty = wherever the app is running.
VITE_SITE_URL=
